{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Curated SMM Document",
  "description": "Schema for shared_mental_model.json — the persistent curated Shared Mental Model. Four pillars of typed entries with stable UUID ids.",
  "type": "object",
  "required": ["intent", "constraints", "risks", "wisdom"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "array",
      "items": { "$ref": "#/$defs/intent_entry" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint_entry" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk_entry" }
    },
    "wisdom": {
      "type": "array",
      "items": { "$ref": "#/$defs/wisdom_entry" }
    }
  },
  "$defs": {
    "id_pattern": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "12-char hex identifier"
    },
    "base_entry": {
      "type": "object",
      "required": ["id", "content", "source", "ts"],
      "properties": {
        "id": { "$ref": "#/$defs/id_pattern" },
        "content": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "enum": ["seed", "event", "curated"]
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        },
        "source_event_id": {
          "$ref": "#/$defs/id_pattern",
          "description": "Originating event id (only set when source == 'event')"
        }
      }
    },
    "intent_entry": {
      "allOf": [
        { "$ref": "#/$defs/base_entry" },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["goal", "customer_intent"]
            },
            "content": { "type": "string", "maxLength": 200 }
          }
        }
      ]
    },
    "constraint_entry": {
      "allOf": [
        { "$ref": "#/$defs/base_entry" },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["decision", "convention"]
            },
            "topic": { "type": "string" },
            "content": { "type": "string", "maxLength": 150 }
          }
        }
      ]
    },
    "risk_entry": {
      "allOf": [
        { "$ref": "#/$defs/base_entry" },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["concern", "assumption", "debt", "question"]
            },
            "severity": {
              "type": "string",
              "enum": ["problem", "uncertainty", "debt"]
            },
            "content": { "type": "string", "maxLength": 200 }
          }
        }
      ]
    },
    "wisdom_entry": {
      "allOf": [
        { "$ref": "#/$defs/base_entry" },
        {
          "type": "object",
          "properties": {
            "content": { "type": "string", "maxLength": 150 }
          }
        }
      ]
    }
  }
}
