{
  "include": ["scripts", "smm", "tests"],
  "extraPaths": [
    "scripts",
    "smm",
    "tests",
    "skills/xp-accept/scripts",
    "skills/xp-quality-review/scripts",
    "skills/xp-sprint-review/scripts",
