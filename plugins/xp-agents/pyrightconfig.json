{
  "include": ["scripts", "smm", "tests"],
  "extraPaths": ["scripts", "smm", "tests"],
  "exclude": ["**/__pycache__", "**/.pytest_cache"],
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportAttributeAccessIssue": "error",
  "reportIndexIssue": "error"
}
