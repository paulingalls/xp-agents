{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording SessionStart..."
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_probe_resolve.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: resolving roots..."
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py",
            "statusMessage": "xp-agents: session start..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording UserPromptSubmit..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PreToolUse:Bash..."
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/pre_tool_bash.py",
            "statusMessage": "xp-agents: commit gate..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PreToolUse (every tool)..."
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PreToolUse:write..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PreToolUse:Agent..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PostToolUse:Bash..."
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PostToolUse:write..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PostToolUse:Agent..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PermissionRequest..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording SubagentStart..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording SubagentStop..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording Stop..."
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/tdd_stop_gate.py",
            "statusMessage": "xp-agents: TDD stop gate..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PreCompact..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PostCompact..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording SessionEnd..."
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/session_end.py",
            "timeout": 2500,
            "statusMessage": "Recording session end...",
            "async": false
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/smm/compact.py",
            "timeout": 1500,
            "statusMessage": "Compacting event log...",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: unrecognised-event probe..."
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: unrecognised-event probe..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: unrecognised-event probe..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: unrecognised-event probe..."
          }
        ]
      }
    ]
  }
}
