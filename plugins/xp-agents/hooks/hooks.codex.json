            "statusMessage": "spike: recording PostToolUse:Bash..."
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PostToolUse:write..."
          }
        ]
      },
      {
