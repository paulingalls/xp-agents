{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording SessionStart..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording UserPromptSubmit..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PreToolUse:Bash..."
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
            "additionalContextLimit": 0,
            "statusMessage": "spike: recording PreToolUse:write..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/spike/_dump_payload.py",
