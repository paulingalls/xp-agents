{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pre_tool_use.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "agent",
            "prompt": "${CLAUDE_PLUGIN_ROOT}/prompts/navigator.md",
            "agent_type": "xp-navigator"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/retrospective.py"
          },
          {
            "type": "agent",
            "prompt": "${CLAUDE_PLUGIN_ROOT}/prompts/retrospective_analyst.md",
            "agent_type": "xp-retrospective-analyst"
          },
          {
            "type": "agent",
            "prompt": "${CLAUDE_PLUGIN_ROOT}/prompts/customer_proxy.md",
            "agent_type": "xp-customer-proxy"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session_end.py",
            "timeout": 2500
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pre_compact.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/subagent_start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/user_prompt_log.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "Plan",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/plan_review.py",
            "timeout": 5000
          },
          {
            "type": "agent",
            "prompt": "${CLAUDE_PLUGIN_ROOT}/prompts/plan_reviewer.md",
            "agent_type": "xp-plan-reviewer"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/subagent_stop.py",
            "timeout": 5000
          },
          {
            "type": "agent",
            "prompt": "${CLAUDE_PLUGIN_ROOT}/prompts/subagent_reviewer.md",
            "agent_type": "xp-subagent-reviewer",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/post_tool_use.py",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lint_check.py",
            "timeout": 10000
          },
          {
            "type": "agent",
            "prompt": "${CLAUDE_PLUGIN_ROOT}/prompts/quality_reviewer.md",
            "agent_type": "xp-quality-reviewer",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/bash_post_tool.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "${CLAUDE_PLUGIN_ROOT}/prompts/tdd_check.md"
          }
        ]
      }
    ]
  }
}
